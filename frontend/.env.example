# Base URL of the backend API
VITE_API_URL=http://localhost:3000

# Auth0 (see support/skills/auth.md). The client secret does NOT belong here:
# it is backend-only and must never be exposed to the frontend.
VITE_AUTH0_DOMAIN=dev-phn04rogxmyfjjar.us.auth0.com
VITE_AUTH0_CLIENT_ID=replace-with-auth0-client-id
VITE_AUTH0_AUDIENCE=https://api.zest.app
# Auth0 Database connection used only to request password-reset emails.
VITE_AUTH0_DB_CONNECTION=Username-Password-Authentication
