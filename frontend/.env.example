# Backend base URL. Local development: http://localhost:3000
# Production: set the public Render URL in Vercel, not in this file.
VITE_API_URL=

# Auth0: fill these in your local .env when using authentication.
# VITE_* values are exposed to the browser. Never put a client secret here.
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=
# Auth0 Database connection used only to request password-reset emails.
VITE_AUTH0_DB_CONNECTION=
