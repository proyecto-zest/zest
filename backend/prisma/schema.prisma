generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RecipeCategory {
  DESAYUNO
  ALMUERZO
  MERIENDA
  CENA
  ENTRADA
  POSTRE
  SNACK
  BEBIDA
}

enum RecipeTimeUnit {
  MINUTOS
  HORAS
}

enum RecipeDifficulty {
  FACIL
  MEDIA
  DIFICIL
}

enum IngredientUnit {
  SIN_UNIDAD
  UNIDAD
  GRAMO
  KILOGRAMO
  MILILITRO
  LITRO
  CUCHARADITA
  CUCHARADA
  TAZA
  ONZA
  LIBRA
  PIZCA
  DIENTE
  LATA
  PAQUETE
  A_GUSTO
}

model User {
  id            String       @id @default(uuid()) @db.Uuid
  auth0Sub      String       @unique @map("auth0_sub") @db.VarChar
  name          String       @db.VarChar
  email         String       @unique @db.VarChar
  emailVerified Boolean      @default(false) @map("email_verified")
  avatarUrl     String?      @map("avatar_url") @db.VarChar
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @default(now()) @updatedAt @map("updated_at")
  recipes       Recipe[]
  collections   Collection[]

  @@map("users")
}

model Recipe {
  id String @id @default(uuid()) @db.Uuid

  authorId    String             @map("author_id") @db.Uuid
  title       String             @db.VarChar
  description String             @db.Text
  category    RecipeCategory
  time        Int
  timeUnit    RecipeTimeUnit     @map("time_unit")
  difficulty  RecipeDifficulty
  servings    Int
  createdAt   DateTime           @default(now()) @map("created_at")
  ingredients RecipeIngredient[]
  steps       RecipeStep[]
  images      RecipeImage[]
  author      User               @relation(fields: [authorId], references: [id], onDelete: Restrict)
  collections CollectionRecipe[]

  @@map("recipes")
}

model Ingredient {
  id      String             @id @default(uuid()) @db.Uuid
  name    String             @unique @db.VarChar
  recipes RecipeIngredient[]

  @@map("ingredients")
}

model RecipeIngredient {
  recipeId     String         @map("recipe_id") @db.Uuid
  ingredientId String         @map("ingredient_id") @db.Uuid
  amount       String         @db.VarChar
  unit         IngredientUnit
  recipe       Recipe         @relation(fields: [recipeId], references: [id])
  ingredient   Ingredient     @relation(fields: [ingredientId], references: [id])

  @@id([recipeId, ingredientId])
  @@map("recipe_ingredients")
}

model RecipeStep {
  id         String @id @default(uuid()) @db.Uuid
  recipeId   String @map("recipe_id") @db.Uuid
  stepNumber Int    @map("step_number")
  text       String @db.Text
  recipe     Recipe @relation(fields: [recipeId], references: [id])

  @@map("recipe_steps")
}

model RecipeImage {
  id       String @id @default(uuid()) @db.Uuid
  recipeId String @map("recipe_id") @db.Uuid
  s3Key    String @map("s3_key") @db.VarChar
  recipe   Recipe @relation(fields: [recipeId], references: [id])

  @@index([recipeId])
  @@map("recipe_images")
}

model Collection {
  id            String             @id @default(uuid()) @db.Uuid
  ownerId       String             @map("owner_id") @db.Uuid
  // `name` is not unique per owner: db.md doesn't specify this constraint,
  // and ZEST-88/89 left it as an open question for the team to decide.
  name          String             @db.VarChar
  // Open question (ZEST-88): should these be nullable with a default instead
  // of required? Left NOT NULL with no default for now — the "New collection"
  // modal already forces picking a cover and an accent color, so in practice
  // neither should ever be missing — but flagging per the ticket in case the
  // team wants a fallback (e.g. a default cover) for a future API/import path
  // that doesn't go through that modal.
  coverImageUrl String             @map("cover_image_url") @db.VarChar
  accentColor   String             @map("accent_color") @db.VarChar
  owner         User               @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  recipes       CollectionRecipe[]

  @@index([ownerId])
  @@map("collections")
}

model CollectionRecipe {
  collectionId String     @map("collection_id") @db.Uuid
  recipeId     String     @map("recipe_id") @db.Uuid
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  // Open question (ZEST-88): the ticket proposes onDelete: Cascade here too
  // (deleting a recipe would silently drop it from every collection). Kept
  // as Restrict instead — deleting a recipe that's still in a collection
  // fails loudly rather than quietly rewriting someone's collection — until
  // the team confirms which behavior they actually want.
  recipe       Recipe     @relation(fields: [recipeId], references: [id])

  @@id([collectionId, recipeId])
  @@map("collection_recipes")
}
