generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RecipeCategory {
  DESAYUNO
  ALMUERZO
  MERIENDA
  CENA
  ENTRADA
  POSTRE
  SNACK
  BEBIDA
}

model Recipe {
  id String @id @default(uuid()) @db.Uuid

  // TODO: pasar a @relation con User y a obligatorio — ver ticket del modelo User
  authorId    String?            @map("author_id") @db.Uuid
  title       String             @db.VarChar
  description String             @db.Text
  category    RecipeCategory
  time        Int
  difficulty  String             @db.VarChar
  servings    Int
  ingredients RecipeIngredient[]
  steps       RecipeStep[]
  images      RecipeImage[]

  @@map("recipes")
}

model Ingredient {
  id      String             @id @default(uuid()) @db.Uuid
  name    String             @unique @db.VarChar
  recipes RecipeIngredient[]

  @@map("ingredients")
}

model RecipeIngredient {
  recipeId     String     @map("recipe_id") @db.Uuid
  ingredientId String     @map("ingredient_id") @db.Uuid
  amount       String     @db.VarChar
  recipe       Recipe     @relation(fields: [recipeId], references: [id])
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])

  @@id([recipeId, ingredientId])
  @@map("recipe_ingredients")
}

model RecipeStep {
  id         String @id @default(uuid()) @db.Uuid
  recipeId   String @map("recipe_id") @db.Uuid
  stepNumber Int    @map("step_number")
  text       String @db.Text
  recipe     Recipe @relation(fields: [recipeId], references: [id])

  @@map("recipe_steps")
}

model RecipeImage {
  id       String @id @default(uuid()) @db.Uuid
  recipeId String @map("recipe_id") @db.Uuid
  imageUrl String @map("image_url") @db.VarChar
  recipe   Recipe @relation(fields: [recipeId], references: [id])

  @@map("recipe_images")
}
